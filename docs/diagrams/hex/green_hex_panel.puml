@startuml green_hex_panel

package hex {
  class GreenHexPanel {
    - tris: SmallHex[6]
    - timer: javax.swing.Timer
    - forming: boolean
    - formDuration: double
    - formTime: double
    - fpsDelay: int
    - particles: java.util.List<Particle>
    - assembled: boolean
    - PARTICLE_POOL: int
    - rnd: java.util.Random
    - lastTimeNanos: long
    + GreenHexPanel()
    - initPieces(): void
    - initParticles(): void
    + resetAnimation(): void
    + startAnimation(): void
    - finalPositions(): java.awt.geom.Point2D.Double[]
    - update(dt: double): void
    - createParticle(background: boolean): Particle
    - lerp(a: double, b: double, t: double): double
    - lerpAngle(a: double, b: double, t: double): double
    + getTris(): SmallHex[]
    + isForming(): boolean
    + getFormTime(): double
    + getFormDuration(): double
  }

  class SmallHex {
    + x: double
    + y: double
    + size: double
    + angle: double
    + displayAngle: double
    + vy: double
    + angularVel: double
    + startX: double
    + startY: double
    + startSize: double
    + startAngle: double
    + targetX: double
    + targetY: double
    + targetSize: double
    + setTarget(tx: double, ty: double, tSize: double): void
  }

  class Particle {
    + x: double
    + y: double
    + vx: double
    + vy: double
    + size: int
    + alpha: float
    + life: double
    + Particle(x: double, y: double, vx: double, vy: double, size: int, alpha: float, life: double)
  }
}

GreenHexPanel --> SmallHex : contains
GreenHexPanel --> Particle : manages
GreenHexPanel ..> javax.swing.Timer : uses
GreenHexPanel ..> java.util.Random : uses

