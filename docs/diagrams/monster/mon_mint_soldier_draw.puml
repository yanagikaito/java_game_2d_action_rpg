@startuml mon_mint_soldier_draw

class MonMintSoldier {
  - sprites: BufferedImage[][]
  - attackSprites: BufferedImage[][]
  - axeSprites: BufferedImage[][]
  - DIRECTIONS: String[]
  - ATTACK_DIRECTIONS: String[]
  - AXE_DIRECTIONS: String[]
  - SPRITE_COUNT: int
  + getWorldX(): int
  + getWorldY(): int
  + getDirection(): String
  + getAttackDirection(): String
  + getSpriteNum(): int
  + getAttacking(): boolean
  + getInvincible(): boolean
  + getCurrentWeapon(): ObjAxe
  + draw(g2:Graphics2D): void
}

class FrameApp {
  + getTileSize(): int
}

class GameWindow {
  + getPlayer(): Player
}

class Player {
  + getWorldX(): int
  + getWorldY(): int
  + getScreenX(): int
  + getScreenY(): int
}

class ObjAxe {
  + getType(): Object
}

class Graphics2D {
  + setComposite(c:Composite): void
