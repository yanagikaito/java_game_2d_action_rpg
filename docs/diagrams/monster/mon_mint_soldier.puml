@startuml mon_mint_soldier

package monster {
  class MonMintSoldier {
    -- Fields --
    - pathfinder: core.PathFinder
    - grid: core.Node[][]
    - goalX: int
    - goalY: int
    - flowFieldInitialized: boolean
    - DIRECTIONS: String[] = {"up","down","left","right"}
    - ATTACK_DIRECTIONS: String[] = {"attackUp","attackDown","attackLeft","attackRight"}
    - AXE_DIRECTIONS: String[] = {"axeUp","axeDown","axeLeft","axeRight"}
    - sprites: BufferedImage[][]
    - attackSprites: BufferedImage[][]
    - axeSprites: BufferedImage[][]
    - currentAttackSprites: BufferedImage[][]
    - SPRITE_COUNT: int = 3
    - ANIMATION_RATE: int = 3
    - SPRITE_ATTACKING_THRESHOLD_NUM1: int = 40
    - SPRITE_ATTACKING_THRESHOLD_NUM2: int = 60
    - SPRITE_ATTACKING_THRESHOLD_NUM3: int = 80
    - ATTACK_ANIMATION_FRAMES: int = SPRITE_ATTACKING_THRESHOLD_NUM3
    - attackCounter: int
    - actionLockCounter: int
    - random: Random
    - ROCK_COOLDOWN_FRAMES: int = 180
    - shotAvailableCounter: int
    - NEW_HAIR_COLOR: int = 0xFF00FF00
    - HAIR_COLORS: Set<Integer>

    -- Methods --
    + MonMintSoldier(gameWindow: GameWindow)
    + loadMonsterImages(): void
    + loadMonsterAttackSprites(): void
    + setAction(): void
    + startAttack(): void
    + updateCurrentAttackSprites(): void
    + monsterAttacking(): void
    + initializeFlowField(): void
    + damageReaction(): void
    + updateMonsterInvincibility(): void
    + draw(g2:Graphics2D): void
    - createImage(original:BufferedImage, width:int, height:int): BufferedImage
    - capitalize(s:String): String
  }
}

package core {
  class PathFinder {
    + PathFinder(grid: Node[][])
    + calculateIntegrationField(goalX:int, goalY:int): void
    + getMoveDirection(x:int, y:int): int
    + getWidth(): int
    + getHeight(): int
  }
  class Node {
    + x:int
    + y:int
    + walkable:boolean
  }
}

package object {
  class ObjAxe {
    + ObjAxe(gameWindow: GameWindow)
    + getAttackValue(): int
    + getKnockBackPower(): int
  }
}

package frame {
  class FrameApp {
    + getTileSize(): int
    + getMaxWorldCol(): int
    + getMaxWorldRow(): int
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
    + getTileManager(): TileManager
    + getCollisionChecker(): CollisionChecker
    + getMonster(): List<Entity>
    + getItile(): List<Entity>
  }
  class TileManager {
    + isObstacle(x:int, y:int): boolean
  }
  class CollisionChecker {
    + checkEntity(source:Entity, targets:List<Entity>): int
  }
}

package entity {
  abstract class Entity {
    + getWorldX(): int
    + getWorldY(): int
    + setWorldX(x:int): void
    + setWorldY(y:int): void
    + setDirection(dir:String): void
    + getDirection(): String
    + setType(t:MonsterType): void
    + setName(n:String): void
    + setDefaultSpeed(s:int): void
    + setSpeed(s:int): void
    + setMaxLife(l:int): void
    + setLife(l:int): void
    + setAttack(a:int): void
    + setDefense(d:int): void
    + setExp(e:int): void
    + setCurrentWeapon(w:ObjAxe): void
    + getCurrentWeapon(): ObjAxe
    + setAttackArea(r:Rectangle): void
    + getAttackArea(): Rectangle
    + getSolidArea(): Rectangle
    + setSolidAreaDefaultX(x:int): void
    + setSolidAreaDefaultY(y:int): void
    + getInvincible(): boolean
    + setInvincible(b:boolean): void
    + getInvincibleCounter(): int
    + setInvincibleCounter(v:int): void
    + getAttacking(): boolean
    + setAttacking(b:boolean): void
    + setAttackDirection(dir:String): void
    + getAttackDirection(): String
    + getSpriteCounter(): int
    + setSpriteCounter(v:int): void
    + getSpriteNum(): int
    + setSpriteNum(v:int): void
    + getHpBarOn(): boolean
    + setHpBarOn(b:boolean): void
    + getHpBarCounter(): int
    + setHpBarCounter(v:int): void
  }
  class MonsterType
}

