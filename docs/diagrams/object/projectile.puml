@startuml projectile

package object {
  abstract class Projectile {
    -- Fields --
    - sprites: BufferedImage[][]
    - SPRITE_COUNT: int = 3
    - SPRITE_ANIMATION_THRESHOLD: int = 12
    - DIRECTIONS: String[] = {"up","down","left","right"}
    - user: Entity

    -- Methods --
    + Projectile(gw: GameWindow, dirCount:int, spriteCount:int)
    # loadSprites(): void
    + set(worldX:int, worldY:int, direction:String, alive:boolean, user:Entity): void
    + update(): void
    - move(): void
    - updateAnimation(): void
    + draw(g2:Graphics2D): void
    + setUser(user:Entity): void
    + getUser(): Entity
  }
}

package entity {
  abstract class Entity {
    + Entity(gw: GameWindow)
    + setWorldX(x:int): void
    + setWorldY(y:int): void
    + getWorldX(): int
    + getWorldY(): int
    + setDirection(dir:String): void
    + getDirection(): String
    + setAlive(b:boolean): void
    + getAlive(): boolean
    + setLife(n:int): void
    + getLife(): int
    + setMaxLife(n:int): void
    + getMaxLife(): int
    + setSpriteNum(n:int): void
    + getSpriteNum(): int
    + setSpriteCounter(n:int): void
    + getSpriteCounter(): int
    + getSpeed(): int
    + getAttack(): int
    + getKnockBackPower(): int
    + getGameWindow(): GameWindow
    + getAttacking(): boolean
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
    + getCollisionChecker(): CollisionChecker
    + getCurrentMap(): GameMap
  }
}

package player {
  class Player {
    + getWorldX(): int
    + getWorldY(): int
    + getScreenX(): int
    + getScreenY(): int
    + damageMonster(id:int, attack:int, knock:int): void
    + getInvincible(): boolean
  }
}

package collision {
  class CollisionChecker {
    + checkTile(e:Entity): boolean
    + checkEntity(p:Projectile, list:List<Entity>): int
    + checkPlayer(p:Projectile): boolean
  }
}

package map {
  class GameMap
}

Projectile --> entity.Entity : extends
Projectile --> window.GameWindow : uses
Projectile --> player.Player : interacts
