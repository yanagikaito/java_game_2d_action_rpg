@startuml obj_chest

package object {
  class ObjChest {
    -- Fields --
    - random: Random
    - gameWindow: GameWindow
    - loot: Entity
    - entityFactory: EntityFactory
    - opened: boolean
    - chestFrames: BufferedImage[]
    - chestFrameIndex: int
    - chestFrameDelay: int
    - chestFrameCounter: int
    - animatingOpen: boolean
    - playerNearby: boolean
    - lootTable: List<LootEntry>

    -- Methods --
    + ObjChest(gameWindow: GameWindow, loot: Entity, entityFactory: EntityFactory)
    + update(): void
    - loadLootTableFromJson(resourcePath: String): void
    - buildLootTableFromConfig(configs: List<LootConfigEntry>): void
    - buildDefaultLootTable(): void
    - createRandomLoot(): Entity
    + interact(player: Player): void
    - open(player: Player): void
    + isOpened(): boolean
    + draw(g2: Graphics2D): void
  }
}

package entity {
  abstract class Entity {
    + getWorldX(): int
    + getWorldY(): int
    + setWorldX(x:int): void
    + setWorldY(y:int): void
    + setName(name:String): void
    + setBlocking(b:boolean): void
    + setImage(img:BufferedImage, tileSize:int): void
    + getImage(): BufferedImage
    + getMaxLife(): int
    + setLife(v:int): void
  }
}

package factory {
  class EntityFactory {
    + createCoinEntity(): Entity
    + createRedPotionEntity(): Entity
    + createGreenPotionEntity(): Entity
    + createBluePotionEntity(): Entity
  }
}

package entity.loot {
  class LootEntry {
    - factory: Supplier<Entity>
    - weight: int
    + factory(): Supplier<Entity>
    + weight(): int
  }
  class LootConfigEntry {
    - type: String
    - weight: int
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
    + getUi(): UI
    + getKeyHandler(): KeyHandler
    + getCurrentMap(): GameMap
    + getSoundmanager(): SoundManager
  }
  class UI {
    + getDamagePopupManager(): DamagePopupManager
  }
  class KeyHandler {
    + isPlayerEnter(): boolean
  }
  class DamagePopupManager {
    + popItem(e:Entity, x:int, y:int, variant:PopupVariant, duration:int): void
  }
  class SoundManager {
    + redPotionWAV(path:String): void
  }
}

package player {
  class Player {
    + getWorldX(): int
    + getWorldY(): int
    + getScreenX(): int
    + getScreenY(): int
    + getDirection(): String
    + addCoin(coin: ObjCoinBronze): void
    + canObtainItem(e:Entity): boolean
  }
}

package frame {
  class FrameApp {
    + getTileSize(): int
  }
}

package map {
  class GameMap {
    + addObject(o: Entity): void
  }
}

package object {
  class ObjCoinBronze
  class ObjBomb
}

package popup {
  enum PopupVariant
}

