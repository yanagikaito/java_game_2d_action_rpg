    + getTileSize(): int
  }
}

package entity.type {
  class RedPotionType
}

package entity {
  abstract class Entity {
    + setType(t:Object): void
    + setName(n:String): void
    + setDescription(d:String): void
    + setPrice(p:int): void
    + setMaxStack(n:int): void
    + setAmount(a:int): void
    + setStackable(b:boolean): void
    + setImage(img:BufferedImage, tileSize:int): void
    + getImage(): BufferedImage
    + getWorldX(): int
    + getWorldY(): int
    + copy(): Entity
  }
}

