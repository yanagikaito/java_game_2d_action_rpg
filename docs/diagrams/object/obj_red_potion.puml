    - name: String = "レッドポーション"
    - description: String
    - price: int = 10
    - maxStack: int = 99
    - amount: int = 1
    - stackable: boolean = true
    - image: BufferedImage

    -- Methods --
    + ObjRedPotion(gameWindow: GameWindow)
    + draw(g2: Graphics2D): void
    + copy(): Entity
    + getHealAmount(): int
    + getPrice(): int
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
  }
}

package frame {
