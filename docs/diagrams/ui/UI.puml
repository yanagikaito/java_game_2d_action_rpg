package window {
  class GameWindow {
    + getGameState(): GameState
    + getPlayer(): Player
    + setDialogueActive(b: boolean): void
    + getKeyHandler(): KeyHandler
    + setGameState(s: GameState): void
    + getLoadedPlayTimeSeconds(): long
  }
}

package save {
  class SaveMeta {
    + exists(): boolean
    + getHp(): int
    + getMaxHp(): int
    + getPlayTimeSeconds(): long
    + getSpriteKey(): String
    + getFacing(): String
  }
  class SaveManager {
    + loadMeta(slot:int): SaveMeta
  }
}

package input {
  class KeyHandler {
    + getCommandNum(): int
    + clearAllKeys(): void
  }
}

package hex {
  class GreenHexPanel {
    + startAnimation(): void
    + resetAnimation(): void
    + getTris(): List
    + isForming(): boolean
    + getFormTime(): int
    + getFormDuration(): int
  }
  class GreenHexRenderer {
    + drawGreenHex(g: Graphics2D, tris: List, forming: boolean, formTime: int, formDuration: int): void
