}

package player {
  class Player {
    + getLife(): int
    + getMaxLife(): int
    + getMana(): int
    + getMaxMana(): int
    + getLevel(): int
    + getStrength(): int
    + getDexterity(): int
    + getExp(): int
    + getNextLevelExp(): int
    + getCoin(): int
    + getCurrentWeapon(): Entity
    + getCurrentShield(): Entity
    + getPlayTimeSeconds(): long
  }
  class SpriteManager {
    + getSprite(key:String, facing:String, frame:int): BufferedImage
  }
}

package entity {
  class Entity {
    + getInventory(): List<Entity>
    + getType(): EntityType
    + getImage(): BufferedImage
    + getAmount(): int
    + getCount(): int
    + getDescription(): String
    + getCurrentWeapon(): Entity
    + getCurrentShield(): Entity
  }
  enum EntityType
}

package ui.state.trade {
  class TradeScreenContext {
    + draw(g2: Graphics2D): void
    + handleKey(keyCode:int): void
  }
  class SaveScreenContext {
    + draw(g2: Graphics2D): void
    + handleKey(keyCode:int): void
  }
  class LoadScreenContext {
    + draw(g2: Graphics2D): void
    + handleKey(keyCode:int): void
  }
}

package frame {
  class FrameApp {
    + getTileSize(): int
    + getScreenWidth(): int
    + getScreenHeight(): int
  }
}

package game {
  enum GameState
}

