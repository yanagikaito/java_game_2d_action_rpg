@startuml sword_aura_particle

package entity.particle {
  abstract class Particle {
    + Particle(GameWindow, Entity, Color, int, int, int, int, int)
    + update(): void
    + draw(Graphics2D): void
    + setLife(int): void
    + getLife(): int
    + getMaxLife(): int
    + setAlive(boolean): void
    + setWorldX(int): void
    + setWorldY(int): void
    + getWorldX(): int
    + getWorldY(): int
  }

  class SwordAuraParticle {
    - gameWindow: GameWindow
    - vx: double
    - vy: double
    - gravity: double
    - initLife: float
    - size: int
    - color: Color
    - rotationSpeed: float
    - angle: float
    + SwordAuraParticle(GameWindow, Entity, int, int, Color, int, int, double, double, double, float)
    + update(): void
    + draw(Graphics2D): void
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
  }
  class Player {
    + getWorldX(): int
    + getWorldY(): int
    + getScreenX(): int
    + getScreenY(): int
  }
}

package entity {
  class Entity {
    + getWorldX(): int
    + getWorldY(): int
    + getAlive(): boolean
  }
}

package java.awt {
  class Graphics2D
  class Color
}

