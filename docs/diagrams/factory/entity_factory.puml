@startuml entity_factory
package factory {
  class EntityFactory {
    - gameWindow: GameWindow
    - ev: MapEvent
    + EntityFactory(gameWindow: GameWindow)
    + create(type: EntityType): Entity
    + createCoinEntity(): Entity
    + createRedPotionEntity(): Entity
    + createGreenPotionEntity(): Entity
    + createBluePotionEntity(): Entity
  }
}

package db {
  class MapEvent
}

package entity {
  class Entity {
    + getWorldX(): int
    + getWorldY(): int
    + getWidth(): int
    + getHeight(): int
  }
  package type {
    class EntityType {
      + typeId(): int
    }
  }
}

package monster {
  class MonGreenSlime
}

package npc {
  class NpcChicken
  class NpcOldMan
}

package object {
  class ObjCoinBronze
  class ObjSwordNormal
  class ObjAxe
  class ObjShieldWood
  class ObjRedPotion
  class ObjGreenPotion
  class ObjBluePotion
  class ObjBomb
}

package player {
  class Player
}

package window {
  class GameWindow {
    + getKeyHandler(): Object
  }
}

