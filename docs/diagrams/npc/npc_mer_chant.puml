@startuml npc_mer_chant

package npc {
  class NpcMerChant {
    -- Fields --
    - gameWindow: GameWindow
    - DIRECTIONS: String[] = {"up","down","left","right"}
    - SPRITE_COUNT: int = 3
    - sprites: BufferedImage[][]
    - dialogueIndex: int
    - eventId: String

    -- Methods --
    + NpcMerChant(gameWindow: GameWindow, ev: db.MapEvent)
    + loadNPCImages(): void
    + applyMapEvent(ev: db.MapEvent): void
    + setItems(): void
    + speak(): void
    + getNextDialogue(): String
    + getShopItems(): ArrayList<Entity>
    + resetDialogue(): void
    + getEventId(): String
    + setEventId(eventId:String): void
    - createImage(original:BufferedImage, width:int, height:int): BufferedImage
  }
}

package frame {
  class FrameApp {
    + getTileSize(): int
  }
}

package window {
  class GameWindow {
    + getPlayer(): Player
    + getUi(): UI
    + setGameState(state: game.GameState): void
  }
}

package object {
  class ObjSwordNormal
  class ObjShieldWood
  class ObjRedPotion
  class ObjGreenPotion
  class ObjBluePotion
}

package db {
  class MapEvent {
    + getId(): String
    + getName(): String
    + getTrigger(): String
    + getDialogues(): List<String>
  }
}

package game {
  enum GameState
}

package entity {
  abstract class Entity {
    + getWorldX(): int
    + getWorldY(): int
    + setDirection(dir:String): void
    + setSpeed(s:int): void
    + setName(n:String): void
    + setTrigger(t:String): void
    + setDialogueArray(arr:String[]): void
    + getDialogue(): String[]
    + getDialogueIndex(): int
    + setDialogueIndex(i:int): void
    + setInventory(items:List<Entity>): void
    + getShopItems(): ArrayList<Entity>
  }
}

