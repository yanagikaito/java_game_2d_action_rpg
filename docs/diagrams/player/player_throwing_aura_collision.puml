@startuml player_throwing_aura_collision

package player {
  class Player {
    -- Fields (throw / aura / collision) --
    - holding: boolean
    - heldBomb: ObjBomb
    - heldPot: ObjPot
    - heldRock: ObjRock
    - heldChicken: NpcChicken
    - pickupCooldown: int
    - PICKUP_COOLDOWN_FRAMES: int {static, final}
    - state: PlayerState
    - spriteNum: int
    - spriteCounter: int
    - aura: ObjAura
    - knockbackTimer: int

    -- Methods (throw / aura / collision) --
    + throwHeldBom(): void
    + throwHeldPot(): void
    + throwHeldRock(): void
    + throwHeldChicken(): void
    + updateAura(deltaMs: long): void
    + resolvePenetration(): void
    + getDirection(): String
    + getWorldX(): int
    + getWorldY(): int
    + setWorldX(x:int): void
    + setWorldY(y:int): void
    + setState(s:PlayerState): void
  }
}

