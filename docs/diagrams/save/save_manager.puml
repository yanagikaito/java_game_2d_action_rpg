@startuml save_manager
package save {
  class SaveManager {
    + saveGame(slot: int, player: player.Player): boolean
    - saveMainData(conn: java.sql.Connection, data: SaveData): void
    - clearInventory(conn: java.sql.Connection, slot: int): void
    - saveInventory(conn: java.sql.Connection, saveId: int, player: player.Player): void
    - saveEquipment(conn: java.sql.Connection, saveId: int, data: SaveData): void
    - saveEquipmentItem(conn: java.sql.Connection, saveId: int, itemType: String, typeId: int): void
    + loadMeta(slotIndex: int): SaveMeta
    + writeMeta(slotIndex: int, meta: SaveMeta): boolean
    + hasSave(slotNumber: int): boolean
    - buildItemSaveDataList(player: player.Player): java.util.List<ItemSaveData>
    - DB_URL: String
    - SLOT_COUNT: int
    - metas: SaveMeta[]
    - SAVE_DIR: String
    - SLOT_PREFIX: String
    - SUFFIX: String
    - gson: com.google.gson.Gson
  }

  record SaveData {
    + id: int
    + x: int
    + y: int
    + mapId: int
    + hp: int
    + maxHp: int
    + mana: int
    + maxMana: int
    + level: int
    + strength: int
    + dexterity: int
    + exp: int
    + next_exp: int
    + coin: int
    + weaponTypeId: int
    + shieldTypeId: int
    + inventory: java.util.List<ItemSaveData>
    + savedAt: java.time.LocalDateTime
  }

  record ItemSaveData {
    + slot: int
    + typeId: int
    + count: int
  }

  class SaveMeta {
    + exists(): boolean
    + getPlayTimeSeconds(): long
    + setPlayTimeSeconds(long): void
  }

  class EntityStateConverter {
    + toSaveData(slot: int, entity: entity.Entity, savedAt: java.time.LocalDateTime): SaveData
  }

  class LoadManager {
    + loadPlayer(slotNumber: int, gameWindow: window.GameWindow): entity.Player
    + hasSaveData(slot: int): boolean
    - loadInventory(conn: java.sql.Connection, saveId: int, player: entity.Entity, gameWindow: window.GameWindow): void
    - loadEquipment(conn: java.sql.Connection, saveId: int, player: entity.Entity, gameWindow: window.GameWindow): void
    - findEntityTypeById(typeId: int): entity.type.EntityType
    - determineMaxStackForType(typeId: int): int
  }
}

package db {
  class DbManager {
    + getConnection(): java.sql.Connection
  }
}

package factory {
  class EntityFactory {
    + EntityFactory(gameWindow: window.GameWindow)
    + create(type: entity.type.EntityType): entity.Entity
  }
}

package player {
  class Player {
    + getPlayTimeSeconds(): long
    + getFacing(): int
    + getSpriteKey(): String
    + getInventory(): java.util.List<entity.Entity>
    + setPlayTimeSeconds(long): void
  }
}

package entity {
  class Entity {
    + getInventory(): java.util.List<Entity>
    + getType(): entity.type.EntityType
    + isStackable(): boolean
    + setMaxStack(int): void
    + setAmount(int): void
    + getAmount(): int
    + getMaxStack(): int
    + getName(): String
  }

  class Player extends Entity {
    + setLoaded(boolean): void
    + setWorldX(int): void
    + setWorldY(int): void
    + setMapId(int): void
    + setLife(int): void
    + setMaxLife(int): void
    + setMana(int): void
    + setMaxMana(int): void
    + setLevel(int): void
    + setStrength(int): void
    + setDexterity(int): void
    + setExp(int): void
    + setNextLevelExp(int): void
    + setCoin(int): void
    + setCurrentWeapon(Entity): void
    + setCurrentShield(Entity): void
  }
}

package entity.type {
  class EntityType {
    + typeId(): int
  }
  class PlayerType
  class NpcType
  class MonsterType
  class ChickenType
  class SwordType
  class AxeType
  class ShieldType
  class RedPotionType
  class GreenPotionType
  class BluePotionType
  class BombType
}

package window {
  class GameWindow {
    + getKeyHandler(): Object
  }
}

