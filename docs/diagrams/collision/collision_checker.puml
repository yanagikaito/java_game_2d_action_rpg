@startuml collision_checker

package collision {
  class CollisionChecker {
    -- Fields --
    - gameWindow: GameWindow

    -- Methods --
    + CollisionChecker(gameWindow: GameWindow)
    + checkTile(entity: Entity): boolean
    + checkTile(entity: Entity, offsetX: int, offsetY: int): boolean
    + checkEntity(entity: Entity, targets: Entity[]): int
    + checkEntity(entity: Entity, targets: Entity[], offsetX: int, offsetY: int): int
    + checkEntity(entity: Entity, tiles: InteractiveTile[], offsetX: int, offsetY: int): int
    + checkPlayer(entity: Entity): boolean
    - isTileIndexValid(tileId: int, tiles: Tile[]): boolean
    + worldSolid(e: Entity): Rectangle
  }
}

